# Image assets
/*.webp
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=600, must-revalidate

# Fonts
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — short cache with revalidation
/*.html
  Cache-Control: public, max-age=600, must-revalidate

# Root HTML
/
  Cache-Control: public, max-age=600, must-revalidate

# CSS — must revalidate so design-token changes ship promptly
/*.css
  Cache-Control: public, max-age=600, must-revalidate

# Favicons - must revalidate so icon changes ship promptly
# (/*.png is a 7-day cache, which is wrong for an icon we iterate on)
/favicon.ico
  Cache-Control: public, max-age=600, must-revalidate
/favicon-emblem.3a4d8ed8.png
  Cache-Control: public, max-age=600, must-revalidate
/apple-touch-emblem.1bde2e82.png
  Cache-Control: public, max-age=600, must-revalidate
