{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Restaurant ItemList",
  "description": "Schema.org ItemList of Restaurant entries for city pages",
  "type": "object",
  "required": ["@context", "@type", "itemListElement"],
  "properties": {
    "@context": { "const": "https://schema.org" },
    "@type": { "const": "ItemList" },
    "name": { "type": "string" },
    "itemListElement": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["@type", "position", "item"],
        "properties": {
          "@type": { "const": "ListItem" },
          "position": { "type": "integer", "minimum": 1 },
          "item": {
            "type": "object",
            "required": ["@type", "name"],
            "properties": {
              "@type": { "const": "Restaurant" },
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "servesCuisine": { "const": "Thai" },
              "address": {
                "type": "object",
                "properties": {
                  "@type": { "const": "PostalAddress" },
                  "addressLocality": { "type": "string" },
                  "postalCode": { "type": "string" },
                  "streetAddress": { "type": "string" }
                }
              },
              "additionalProperty": {
                "type": "object",
                "required": ["@type", "name", "value"],
                "properties": {
                  "@type": { "const": "PropertyValue" },
                  "name": { "pattern": "^FSA" },
                  "value": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
