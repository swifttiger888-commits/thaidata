{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThaiData UK — Restaurant Directory Schema",
  "description": "Schema for data/restaurants.json — the single source of truth for all UK Thai restaurant data",
  "type": "object",
  "required": ["name", "updated", "total", "sources", "restaurants"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Dataset name",
      "enum": ["ThaiData UK — Restaurant Directory"]
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Data refresh date (ISO 8601 date)"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Total count of restaurant records"
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "restaurants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "name", "type", "city", "local_authority",
          "postcode", "address", "hygiene_rating", "rating_date",
          "longitude", "latitude"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "FSA FHRSID — unique establishment identifier"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Business name"
          },
          "type": {
            "type": "string",
            "enum": ["restaurant", "takeaway"],
            "description": "Business type classification"
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "description": "Mapped city name (derived from LocalAuthorityName)"
          },
          "local_authority": {
            "type": "string",
            "minLength": 1,
            "description": "FSA Local Authority name"
          },
          "postcode": {
            "type": "string",
            "description": "UK postcode (may be empty string if unavailable)"
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "description": "Combined address lines"
          },
          "hygiene_rating": {
            "type": "string",
            "description": "Hygiene rating value (0-5, or special values like 'AwaitingPublication', 'Exempt')",
            "pattern": "^(\\d|[0-5]|AwaitingPublication|Exempt)$"
          },
          "rating_date": {
            "type": "string",
            "description": "Date of last inspection (ISO 8601 datetime or empty string)"
          },
          "longitude": {
            "type": ["number", "string"],
            "description": "Longitude coordinate (may be empty string if not geocoded)"
          },
          "latitude": {
            "type": ["number", "string"],
            "description": "Latitude coordinate (may be empty string if not geocoded)"
          },
          "region": {
            "type": "string",
            "description": "UK region (e.g. 'East Midlands', 'London')"
          },
          "hygiene_score": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 25,
            "description": "FSA detail hygiene score (0-25, lower=better). Only for FHRS restaurants."
          },
          "structural_score": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 25,
            "description": "FSA detail structural score (0-25, lower=better). Only for FHRS restaurants."
          },
          "management_score": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 25,
            "description": "FSA detail management score (0-25, lower=better). Only for FHRS restaurants."
          }
        }
      }
    }
  }
}
