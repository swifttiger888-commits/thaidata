{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThaiData UK — City Statistics Schema",
  "description": "Schema for api/v1/cities.json — city-level aggregate statistics",
  "type": "object",
  "required": ["name", "version", "updated", "total_uk", "cities_tracked", "cities"],
  "properties": {
    "name": {
      "type": "string",
      "enum": ["ThaiData UK — Thai Restaurant Data API"]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "description": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "total_uk": {
      "type": "integer",
      "minimum": 0
    },
    "cities_tracked": {
      "type": "integer",
      "minimum": 1
    },
    "cities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name", "population", "total_thai_businesses",
          "restaurants", "takeaways", "avg_hygiene_rating"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "ONS 2024 mid-year population estimate, may be null for non-city areas"
          },
          "total_thai_businesses": {
            "type": "integer",
            "minimum": 1
          },
          "restaurants": {
            "type": "integer",
            "minimum": 0
          },
          "takeaways": {
            "type": "integer",
            "minimum": 0
          },
          "per_100k": {
            "type": ["number", "null"],
            "description": "Businesses per 100,000 population. Null if population unknown."
          },
          "avg_hygiene_rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "postcode_areas": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
