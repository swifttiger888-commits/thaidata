{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThaiData UK — Data Overview Schema",
  "description": "Schema for api/v1/data.json — overview statistics",
  "type": "object",
  "required": ["name", "last_updated", "statistics"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "last_updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "statistics": {
      "type": "object",
      "required": [
        "total_uk_thai_businesses",
        "total_full_service_restaurants",
        "total_quick_service_takeaways"
      ],
      "properties": {
        "total_uk_thai_businesses": { "type": "integer", "minimum": 0 },
        "total_full_service_restaurants": { "type": "integer", "minimum": 0 },
        "total_quick_service_takeaways": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
