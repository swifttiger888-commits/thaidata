{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FAQPage",
  "description": "Schema.org FAQPage for city pages",
  "type": "object",
  "required": ["@context", "@type", "mainEntity"],
  "properties": {
    "@context": { "const": "https://schema.org" },
    "@type": { "const": "FAQPage" },
    "mainEntity": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["@type", "name", "acceptedAnswer"],
        "properties": {
          "@type": { "const": "Question" },
          "name": { "type": "string" },
          "acceptedAnswer": {
            "type": "object",
            "required": ["@type", "text"],
            "properties": {
              "@type": { "const": "Answer" },
              "text": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
