# Cloudflare Pages redirects
# Docs: https://developers.cloudflare.com/pages/configuration/redirects/

# Redirect bare paths (which hit SPA fallback → index.html) to their XML files
/sitemap /sitemap.xml 301
/sitemap-pages /sitemap-pages.xml 301

# City hub pages — rewrite /r/<city>/ to cities/<city>.html
/r/:city  /r/:city/  301
/r/:city/  /cities/:city.html  200

# Redirect consolidated duplicate recipe page (same dish: Lao vs Thai name)
/recipes/yam-khao-tod/  /recipes/nam-khao-tod/  301
/recipes/yam-khao-tod  /recipes/nam-khao-tod/  301

# Redirect deleted non-Thai chain pages
/chains/chai-green /chains/ 301
/chains/i-chai-express /chains/ 301
/recipes/gaeng-hung-lay/ /recipes/kaeng-hang-lay/ 301
/recipes/khao-tom-mud/ /recipes/khao-tom-mat/ 301

