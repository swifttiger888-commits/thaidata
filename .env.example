# ThaiData UK — Environment Variables
# Copy this to .env and fill in your values
# These override wrangler.toml vars in local dev / cron context

# Admin password for /admin panel (set in Cloudflare Dashboard for production)
ADMIN_PASSWORD=your-secure-password-here

# Secret key for signing magic link tokens (64+ chars, random)
MAGIC_LINK_SECRET=your-64-char-random-secret-string-here-change-me

# Resend API key for magic link emails (starts with re_)
RESEND_API_KEY=re_your-resend-api-key

# Site URL (no trailing slash)
SITE_URL=https://thaidata.uk
